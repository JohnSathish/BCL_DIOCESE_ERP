# Copy to .env.development for local work (never commit real secrets)
NODE_ENV=development

DATABASE_URL=postgresql://bcl:bclsecret@localhost:5433/bcl_enterprise?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DIOCESE_PRIMARY_DOMAIN=turadiocese.in
DIOCESE_PUBLIC_BASE_DOMAIN=turadiocese.in
CMS_RESOLVE_API_URL=http://localhost:4000/api/v1

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

SEED_SUPER_ADMIN_EMAIL=admin@basecodelabs.com
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_ON_START=true
