{
  "expo": {
    "name": "BCL Parish App",
    "slug": "bcl-parish-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bclparish",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F4A"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BCL Parish App to scan certificate QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C5A059",
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow BCL Parish App to add Holy Mass times to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.basecodelabs.parish",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F4A"
      },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS", "READ_CALENDAR", "WRITE_CALENDAR"]
    },
    "ios": {
      "bundleIdentifier": "com.basecodelabs.parish",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan parish certificate QR codes for verification.",
        "NSFaceIDUsageDescription": "Unlock BCL Parish App securely.",
        "NSCalendarsUsageDescription": "Add Holy Mass reminders to your calendar.",
        "NSRemindersUsageDescription": "Set reminders for upcoming Mass times."
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "eb8248da-1cc7-4455-9cbf-b5e1f9a01a2a"
      },
      "subtitle": "Faith. Service. Community."
    }
  }
}
