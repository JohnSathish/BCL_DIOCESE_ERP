  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish?                  @relation(fields: [parishId], references: [id])
  invoice      AccommodationRentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNo])
  @@index([invoiceId])
  @@index([organizationId])
  @@index([paidAt])
}

model AccommodationMaintenanceRequest {
  id             String                    @id @default(cuid())
  organizationId String
