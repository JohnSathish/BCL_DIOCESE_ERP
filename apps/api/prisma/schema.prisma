  subject        String?
  bodyText       String?  @db.Text
  bodyHtml       String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, templateKey, language])
  @@index([templateKey, language])
}

model TranslationJob {
  id             String               @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  sourceLocale   String               @default("en")
  targetLocale   String
  status         TranslationJobStatus @default(PENDING)
  aiDraftJson    Json?
  reviewedById   String?
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy   User?                  @relation("TranslationJobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  suggestions  TranslationSuggestion[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
}

model TranslationSuggestion {
  id            String   @id @default(cuid())
  jobId         String
  field         String
  sourceText    String?  @db.Text
  suggestedText String?  @db.Text
  confidence    Float?
  createdAt     DateTime @default(now())

  job TranslationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
