  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audience     AppNotificationAudience?
  deliveries   AppNotificationDelivery[]
  communications CommunicationMessage[]
  translations AppNotificationTranslation[]

  @@index([organizationId, status])
  @@index([scheduledAt])
  @@index([category])
}

model AppNotificationAudience {
  id               String           @id @default(cuid())
  appNotificationId String          @unique
  scope            AppAudienceScope @default(PARISHES)
  deaneryId        String?
  parishIdsJson    Json?
  rolesJson        Json?
  filtersJson      Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  notification AppNotification @relation(fields: [appNotificationId], references: [id], onDelete: Cascade)
}

model AppNotificationDelivery {
  id                String         @id @default(cuid())
  appNotificationId String
  userId            String?
  pushTokenId       String?
  status            DeliveryStatus @default(PENDING)
  channel           String         @default("IN_APP")
  error             String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime       @default(now())

  notification AppNotification @relation(fields: [appNotificationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([appNotificationId, status])
  @@index([userId, status])
  @@index([createdAt])
}

// ——— Accommodation Management ———

enum AccommodationType {
  STAFF_QUARTERS
  PRESBYTERY
  BISHOPS_HOUSE
  GUEST_HOUSE
  CONVENT
  SEMINARY
  HOSTEL
  STAFF_HOSTEL
  TEACHERS_QUARTERS
  HOSPITAL_STAFF_QUARTERS
  MISSION_HOUSE
  RETREAT_CENTRE
  PILGRIM_ACCOMMODATION
  OTHER
}

enum AccommodationFacilityStatus {
  ACTIVE
  INACTIVE
  UNDER_RENOVATION
  DECOMMISSIONED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  UNDER_MAINTENANCE
  RENOVATION
  BLOCKED
  DECOMMISSIONED
}

enum OccupantKind {
  PRIEST
  RELIGIOUS_SISTER
  STAFF
  TEACHER
  EMPLOYEE
  VOLUNTEER
  GUEST
  SEMINARIAN
}

enum AllocationStatus {
  ACTIVE
  TRANSFERRED
  VACATED
  CANCELLED
}

enum RentInvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  PAINTING
  CLEANING
  FURNITURE
  INTERNET
  GENERATOR
  WATER_SUPPLY
  OTHER
}

model AccommodationFacility {
  id             String                      @id @default(cuid())
  organizationId String
  parishId       String?
  institutionId  String?
  code           String
  name           String
  type           AccommodationType           @default(STAFF_QUARTERS)
  address        String?
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  totalFloors    Int?
  totalRooms     Int?
  capacity       Int?
  yearBuilt      Int?
  status         AccommodationFacilityStatus @default(ACTIVE)
  description    String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish?              @relation(fields: [parishId], references: [id])
  institution  Institution?         @relation(fields: [institutionId], references: [id])
  blocks       AccommodationBlock[]
  rooms        AccommodationRoom[]
  guestStays   AccommodationGuestStay[]
  inspections  AccommodationInspection[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parishId])
  @@index([institutionId])
  @@index([type])
  @@index([status])
}

model AccommodationBlock {
  id         String   @id @default(cuid())
  facilityId String
  code       String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  facility AccommodationFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  floors   AccommodationFloor[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

model AccommodationFloor {
  id        String   @id @default(cuid())
  blockId   String
  level     Int
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  block AccommodationBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms AccommodationRoom[]

  @@unique([blockId, level])
  @@index([blockId])
}

model AccommodationRoom {
  id              String     @id @default(cuid())
  facilityId      String
  floorId         String
  roomNumber      String
  roomType        String?
  capacity        Int        @default(1)
  areaSqFt        Float?
  furnished       Boolean    @default(true)
  attachedBath    Boolean    @default(false)
  kitchen         Boolean    @default(false)
  balcony         Boolean    @default(false)
  electricityMeter String?
  waterMeter      String?
  wifiAvailable   Boolean    @default(false)
  parking         Boolean    @default(false)
  status          RoomStatus @default(AVAILABLE)
  monthlyRentDefault Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  facility     AccommodationFacility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  floor        AccommodationFloor                 @relation(fields: [floorId], references: [id], onDelete: Cascade)
  allocations  AccommodationAllocation[]
  maintenance  AccommodationMaintenanceRequest[]
  guestStays   AccommodationGuestStay[]
  inspections  AccommodationInspection[]
  assets       AccommodationRoomAsset[]

  @@unique([facilityId, roomNumber])
  @@index([facilityId, status])
  @@index([floorId])
  @@index([status])
}

model AccommodationOccupant {
  id                 String       @id @default(cuid())
  organizationId     String
  userId             String?
  kind               OccupantKind @default(STAFF)
  name               String
  priestId           String?
  institutionId      String?
  employeeCode       String?
  designation        String?
  contactPhone       String?
  contactEmail       String?
  familyMembersJson  Json?
  emergencyContact   String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                     @relation(fields: [userId], references: [id])
  priest       Priest?                   @relation(fields: [priestId], references: [id])
  institution  Institution?              @relation(fields: [institutionId], references: [id])
  allocations  AccommodationAllocation[]

  @@index([organizationId])
  @@index([userId])
  @@index([priestId])
  @@index([kind])
  @@index([name])
}

model AccommodationAllocation {
  id               String           @id @default(cuid())
  organizationId   String
  parishId         String?
  roomId           String
  occupantId       String
  startDate        DateTime
  expectedEndDate  DateTime?
  actualEndDate    DateTime?
  monthlyRent      Decimal          @db.Decimal(12, 2) @default(0)
  securityDeposit  Decimal          @db.Decimal(12, 2) @default(0)
  remarks          String?
  status           AllocationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish?                        @relation(fields: [parishId], references: [id])
  room         AccommodationRoom              @relation(fields: [roomId], references: [id])
  occupant     AccommodationOccupant          @relation(fields: [occupantId], references: [id])
  vacateOrders AccommodationVacateOrder[]
  invoices     AccommodationRentInvoice[]

  @@index([organizationId])
  @@index([parishId])
  @@index([roomId, status])
  @@index([occupantId])
  @@index([status, startDate])
}

model AccommodationVacateOrder {
  id               String    @id @default(cuid())
  allocationId     String
  vacateDate       DateTime
  outstandingRent  Decimal   @db.Decimal(12, 2) @default(0)
  damagesNote      String?
  clearanceNo      String?
  clearanceIssuedAt DateTime?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  allocation AccommodationAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@index([vacateDate])
}

model AccommodationRentInvoice {
  id             String            @id @default(cuid())
  organizationId String
  parishId       String?
  allocationId   String
  invoiceNo      String
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime?
  rentAmount     Decimal           @db.Decimal(12, 2) @default(0)
  electricity    Decimal           @db.Decimal(12, 2) @default(0)
  water          Decimal           @db.Decimal(12, 2) @default(0)
  maintenance    Decimal           @db.Decimal(12, 2) @default(0)
  parking        Decimal           @db.Decimal(12, 2) @default(0)
  otherCharges   Decimal           @db.Decimal(12, 2) @default(0)
  totalAmount    Decimal           @db.Decimal(12, 2) @default(0)
  paidAmount     Decimal           @db.Decimal(12, 2) @default(0)
  status         RentInvoiceStatus @default(ISSUED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

