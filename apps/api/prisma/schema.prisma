generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCode {
  DIOCESE_ERP
  ONECAMPUS
  SCHOOL_ERP
  HRMS
  CRM
  ACCOUNTS
}

enum ScopeType {
  PLATFORM
  ORGANIZATION
  DIOCESE
  DEANERY
  PARISH
  SUBSTATION
  BCC
}

enum FamilyStatus {
  ACTIVE
  INACTIVE
  MIGRATED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
  BACHELOR
  WIDOWER
  VIRGIN
  WIDOW
}

enum MemberLifeStatus {
  ALIVE
  DECEASED
  TRANSFERRED
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
}

enum SacramentType {
  BAPTISM
  CONFIRMATION
  HOLY_COMMUNION
  MARRIAGE
  HOLY_ORDERS
  ANOINTING
  DEATH
}

enum CertificateType {
  BAPTISM
  MARRIAGE
  CONFIRMATION
  COMMUNION
  DEATH
  MEMBERSHIP
  LETTER_OF_FREEDOM
  BONAFIDE
  FAMILY
  CUSTOM
}

enum RegisterBookType {
  BAPTISM
  MARRIAGE
  DEATH
  CONFIRMATION
  COMMUNION
  MASS
  DONATION
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  productCode ProductCode  @default(DIOCESE_ERP)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users            User[]
  scopes           Scope[]
  dioceseProfile   DioceseProfile?
  deaneries        Deanery[]
  parishes         Parish[]
  substations      SubStation[]
  bccs             Bcc[]
  families         Family[]
  members          Member[]
  mediaAssets      MediaAsset[]
  auditLogs        AuditLog[]
  licenses         License[]
  subscriptions    Subscription[]
  memberships      Membership[]
  sacraments       SacramentRecord[]
  certificates     Certificate[]
  registerBooks    RegisterBook[]
  masses           MassEvent[]
  donations        Donation[]
  accounts         FinanceAccount[]
  transactions     FinanceTransaction[]
  budgets          Budget[]
  cemeteries       Cemetery[]
  catechismClasses CatechismClass[]
  communications   CommunicationMessage[]
  calendarEvents   ParishCalendarEvent[]
  priests          Priest[]
  priestTransfers  PriestTransfer[]
  congregations    Congregation[]
  institutions     Institution[]
  cmsSites         CmsSite[]
  parishDomains    ParishDomain[]
  cmsFormSubmissions CmsFormSubmission[]
  cmsRedirects     CmsRedirect[]
  cmsContentVersions CmsContentVersion[]
  cmsNewsletterSubscribers CmsNewsletterSubscriber[]
  cmsNewsletterCampaigns CmsNewsletterCampaign[]
  aiQueryLogs      AiQueryLog[]
  ocrJobs          OcrJob[]
  importJobs       ImportJob[]
  reportSchedules  ReportSchedule[]
  mobileAppConfigs MobileAppConfig[]
  dioceseMobileOverrides DioceseMobileOverride[]
  devicePushTokens DevicePushToken[]
  appNotifications AppNotification[]
  timelineEvents   TimelineEvent[]
  halls            Hall[]
  hallBookings     HallBooking[]
  accommodationFacilities AccommodationFacility[]
  accommodationOccupants  AccommodationOccupant[]
  accommodationAllocations AccommodationAllocation[]
  accommodationRentInvoices AccommodationRentInvoice[]
  accommodationRentPayments AccommodationRentPayment[]
  accommodationMaintenance AccommodationMaintenanceRequest[]
  accommodationGuestStays AccommodationGuestStay[]
  accommodationInspections AccommodationInspection[]
  dailyLiturgyDays         DailyLiturgyDay[]
  liturgyImportBatches     LiturgyImportBatch[]
  dailyContentOverrides    DailyContentOverride[]
  liturgyReflectionVariants DailyLiturgyReflectionVariant[]
  dioceseLanguages         DioceseLanguage[]
  uiTranslationNamespaces  UiTranslationNamespace[]
  emailTemplateTranslations EmailTemplateTranslation[]
  translationJobs          TranslationJob[]
  massScheduleEntries      MassScheduleEntry[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isActive       Boolean   @default(true)
  isSuperAdmin   Boolean   @default(false)
  mustChangePassword Boolean @default(false)
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  sessions     Session[]
  userRoles    UserRole[]
  memberships  Membership[]
  auditLogs    AuditLog[]
  devicePushTokens DevicePushToken[]
  appNotificationDeliveries AppNotificationDelivery[]
  preferencesJson Json?
  liturgyImportBatches LiturgyImportBatch[]
  dailyContentOverrides DailyContentOverride[]
  liturgyReflectionVariants DailyLiturgyReflectionVariant[]
  accommodationOccupants AccommodationOccupant[]
  uiTranslationNamespaces UiTranslationNamespace[]
  translationJobsReviewed TranslationJob[] @relation("TranslationJobReviewer")
  loginOtpChallenges     LoginOtpChallenge[]
  passwordResetChallenges PasswordResetChallenge[]
  trustedDevices         TrustedDevice[]
  authEvents             AuthEvent[]
}

model LoginOtpChallenge {
  id            String    @id @default(cuid())
  userId        String
  challengeHash String    @unique
  otpHash       String
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  verifiedAt    DateTime?
  consumedAt    DateTime?
  lastSentAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id            String    @id @default(cuid())
  userId        String
  challengeHash String    @unique
  otpHash       String
  resetTokenHash String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  verifiedAt    DateTime?
  consumedAt    DateTime?
  lastSentAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  deviceName      String?
  browser         String?
  operatingSystem String?
  platform        String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  isActive        Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
}

model AuthEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  ipAddress  String?
  userAgent  String?
  deviceName String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Scope {
  id             String    @id @default(cuid())
  organizationId String?
  type           ScopeType
  name           String
  path           String
  parentId       String?
  refId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  parent       Scope?        @relation("ScopeTree", fields: [parentId], references: [id])
  children     Scope[]       @relation("ScopeTree")
  userRoles    UserRole[]
  memberships  Membership[]

  @@index([organizationId])
  @@index([path])
  @@index([type])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scopeId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scope Scope? @relation(fields: [scopeId], references: [id])

  @@index([userId])
  @@unique([userId, roleId, scopeId])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  scopeId        String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope        Scope?       @relation(fields: [scopeId], references: [id])

  @@unique([userId, organizationId])
}

model License {
  id             String    @id @default(cuid())
  organizationId String
  productCode    ProductCode
  seats          Int       @default(50)
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String   @id @default(cuid())
  organizationId String
  planCode       String   @default("standard")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DioceseProfile {
  id             String    @id @default(cuid())
  organizationId String    @unique
  officialName   String
  logoUrl        String?
  sealUrl        String?
  bishopName     String?
  vicarGeneral   String?
  chanceryAddress String?
  phone          String?
  email          String?
  website        String?
  /// Apex public domain for this diocese (e.g. turadiocese.in) — parish subdomains hang off this
  primaryDomain  String?
  establishedOn  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Deanery {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  deanName       String?
  scopeId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parishes     Parish[]
  translations DeaneryTranslation[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Parish {
  id             String    @id @default(cuid())
  organizationId String
  deaneryId      String?
  name           String
  code           String
  logoUrl        String?
  history        String?
  patronSaint    String?
  feastDay       String?
  address        String?
  village        String?
  latitude       Float?
  longitude      Float?
  website        String?
  email          String?
  phone          String?
  priestsJson    Json?
  massTimings    Json?
  officeTimings  Json?
  committeesJson Json?
  scopeId        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deanery      Deanery?     @relation(fields: [deaneryId], references: [id])
  substations  SubStation[]
  bccs         Bcc[]
  families     Family[]
  members      Member[]
  sacraments   SacramentRecord[]
  certificates Certificate[]
  registerBooks RegisterBook[]
  masses       MassEvent[]
  donations    Donation[]
  accounts     FinanceAccount[]
  transactions FinanceTransaction[]
  budgets      Budget[]
  cemeteries   Cemetery[]
  halls        Hall[]
  hallBookings HallBooking[]
  catechismClasses CatechismClass[]
  communications CommunicationMessage[]
  calendarEvents ParishCalendarEvent[]
  priests      PriestAssignment[]
  priestTransfers PriestTransfer[]
  institutions Institution[]
  cmsSite          CmsSite?
  parishDomains    ParishDomain[]
  cmsPages         CmsPage[]
  cmsPosts         CmsPost[]
  cmsEvents        CmsEvent[]
  cmsAnnouncements CmsAnnouncement[]
  cmsMedia         CmsMedia[]
  cmsForms         CmsForm[]
  cmsFormSubmissions CmsFormSubmission[]
  cmsVisitDaily    CmsSiteVisitDaily[]
  cmsVisitorSessions CmsSiteVisitorSession[]
  cmsVisitorDaily  CmsSiteVisitorDaily[]
  cmsMenus         CmsMenu[]
  cmsRedirects     CmsRedirect[]
  cmsContentVersions CmsContentVersion[]
  cmsNewsletterSubscribers CmsNewsletterSubscriber[]
  cmsNewsletterCampaigns CmsNewsletterCampaign[]
  importJobs       ImportJob[]
  reportSchedules  ReportSchedule[]
  mobileAppConfig  MobileAppConfig?
  devicePushTokens DevicePushToken[]
  accommodationFacilities AccommodationFacility[]
  accommodationAllocations AccommodationAllocation[]
  accommodationRentInvoices AccommodationRentInvoice[]
  accommodationRentPayments AccommodationRentPayment[]
  accommodationMaintenance AccommodationMaintenanceRequest[]
  accommodationGuestStays AccommodationGuestStay[]

  dailyContentOverrides DailyContentOverride[]
  translations          ParishTranslation[]
  massScheduleEntries   MassScheduleEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([deaneryId])
}

model SubStation {
  id             String    @id @default(cuid())
  organizationId String
  parishId       String
  name           String
  code           String
  address        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish       @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([parishId, code])
  @@index([organizationId])
}

model Bcc {
  id             String    @id @default(cuid())
  organizationId String
  parishId       String
  name           String
  code           String
  ward           String?
  village        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish       @relation(fields: [parishId], references: [id], onDelete: Cascade)
  families     Family[]

  @@unique([parishId, code])
  @@index([organizationId])
}

model Family {
  id               String       @id @default(cuid())
  organizationId   String
  parishId         String
  bccId            String?
  familyCode       String
  qrToken          String       @unique
  photoUrl         String?
  housePhotoUrl    String?
  houseName        String?
  houseNumber      String?
  village          String?
  ward             String?
  zone             String?
  scc              String?
  address          String?
  phone            String?
  whatsapp         String?
  email            String?
  emergencyContact String?
  language         String?
  occupation       String?
  income           Decimal?     @db.Decimal(12, 2)
  latitude         Float?
  longitude        Float?
  ministries       String?
  inCatechism      Boolean      @default(false)
  status           FamilyStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish           Parish             @relation(fields: [parishId], references: [id], onDelete: Cascade)
  bcc              Bcc?               @relation(fields: [bccId], references: [id])
  memberships      FamilyMembership[]
  documents        FamilyDocument[]

  @@unique([parishId, familyCode])
  @@index([organizationId])
  @@index([parishId])
  @@index([parishId, village])
  @@index([parishId, status])
}

model Member {
  id               String           @id @default(cuid())
  organizationId   String
  parishId         String
  memberCode       String
  photoUrl         String?
  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime?
  gender           Gender?
  occupation       String?
  education        String?
  bloodGroup       String?
  phone            String?
  email            String?
  maritalStatus    MaritalStatus?
  disability       String?
  nationality      String?          @default("Indian")
  tribe            String?
  aadhaar          String?
  address          String?
  emergencyName    String?
  emergencyPhone   String?
  lifeStatus       MemberLifeStatus @default(ALIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish                 Parish             @relation(fields: [parishId], references: [id], onDelete: Cascade)
  familyMemberships      FamilyMembership[]
  relationshipsFrom      Relationship[]     @relation("RelFrom")
  relationshipsTo        Relationship[]     @relation("RelTo")
  sacraments             SacramentRecord[]  @relation("SacramentSubject")
  sacramentsAsSpouse     SacramentRecord[]  @relation("SacramentSpouse")
  certificates           Certificate[]

  @@unique([parishId, memberCode])
  @@index([organizationId])
  @@index([parishId])
}

model FamilyMembership {
  id        String   @id @default(cuid())
  familyId  String
  memberId  String
  isHead    Boolean  @default(false)
  relation  String?
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyId, memberId])
}

model Relationship {
  id           String           @id @default(cuid())
  fromMemberId String
  toMemberId   String
  type         RelationshipType
  createdAt    DateTime         @default(now())

  fromMember Member @relation("RelFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   Member @relation("RelTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, type])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model FamilyDocument {
  id        String   @id @default(cuid())
  familyId  String
  title     String
  fileUrl   String
  mimeType  String?
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  url            String
  mimeType       String?
  sizeBytes      Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SacramentRecord {
  id               String        @id @default(cuid())
  organizationId   String
  parishId         String
  type             SacramentType
  registerNumber   String
  registerYear     Int
  celebratedAt     DateTime
  churchName       String?
  ministerName     String?
  place            String?
  remarks          String?
  scanImageUrl     String?
  memberId         String?
  spouseMemberId   String?

  // Baptism / shared person fields
  birthDate          DateTime?
  birthPlace         String?
  childName          String?
  childGender        Gender?
  fatherName         String?
  motherName         String?
  nationality        String?
  parentsDomicile    String?
  fatherOccupation   String?
  placeOfBaptism     String?
  godFatherName      String?
  godMotherName      String?
  sponsorName        String?
  className          String?
  teacherName        String?
  schoolName         String?

  // Marriage — bridegroom
  bridegroomName           String?
  bridegroomSurname        String?
  bridegroomFatherName     String?
  bridegroomMotherName     String?
  bridegroomDob            DateTime?
  bridegroomNationality    String?
  bridegroomDomicile       String?
  bridegroomOccupation     String?
  bridegroomMaritalStatus  String?
  bridegroomPreviousSpouse String?

  // Marriage — bride
  brideName           String?
  brideSurname        String?
  brideFatherName     String?
  brideMotherName     String?
  brideDob            DateTime?
  brideNationality    String?
  brideDomicile       String?
  brideOccupation     String?
  brideMaritalStatus  String?
  bridePreviousSpouse String?

  // Marriage — canonical / witnesses / clergy
  witness1Name       String?
  witness1Village    String?
  witness2Name       String?
  witness2Village    String?
  bannsPublished     Boolean       @default(false)
  bann1At            DateTime?
  bann2At            DateTime?
  bann3At            DateTime?
  dispensationNotes  String?
  parishPriestName   String?
  placeOfMarriage    String?

  // Death
  burialDate         DateTime?
  cemeteryName       String?
  graveNumber        String?
  funeralCelebrant   String?
  causeOfDeath       String?
  placeOfDeath       String?

  signaturesJson     Json?
  detailsJson        Json?
  certificateId      String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish        @relation(fields: [parishId], references: [id], onDelete: Cascade)
  member       Member?       @relation("SacramentSubject", fields: [memberId], references: [id])
  spouseMember Member?       @relation("SacramentSpouse", fields: [spouseMemberId], references: [id])
  certificate  Certificate?  @relation(fields: [certificateId], references: [id])
  registerEntry RegisterEntry?

  @@unique([parishId, type, registerYear, registerNumber])
  @@index([organizationId])
  @@index([parishId, type])
  @@index([memberId])
  @@index([celebratedAt])
}

model Certificate {
  id             String          @id @default(cuid())
  organizationId String
  parishId       String
  type           CertificateType
  title          String
  serialNumber   String
  qrToken        String          @unique
  issuedAt       DateTime        @default(now())
  issuedToName   String
  memberId       String?
  payloadJson    Json
  digitalSignBy  String?
  isRevoked      Boolean         @default(false)
  printCount     Int             @default(0)
  lastPrintedAt  DateTime?
  lastPrintReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish                @relation(fields: [parishId], references: [id], onDelete: Cascade)
  member       Member?               @relation(fields: [memberId], references: [id])
  sacrament    SacramentRecord?
  printLogs    CertificatePrintLog[]

  @@unique([parishId, type, serialNumber])
  @@index([organizationId])
  @@index([qrToken])
}

model CertificatePrintLog {
  id            String   @id @default(cuid())
  certificateId String
  printNumber   Int
  printedAt     DateTime @default(now())
  printedById   String?
  printedByName String?
  reason        String   @default("ORIGINAL")
  printerName   String?
  computerName  String?
  ipAddress     String?
  remarks       String?

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

