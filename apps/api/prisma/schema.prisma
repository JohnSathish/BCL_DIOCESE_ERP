model AccommodationRoomAsset {
  id           String   @id @default(cuid())
  roomId       String
  name         String
  assetType    String?
  quantity     Int      @default(1)
  condition    String?
  issuedAt     DateTime?
  replacedAt   DateTime?
  historyJson  Json?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  room AccommodationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([assetType])
}

/// Date-keyed liturgical master (one row per calendar date per organization).
model DailyLiturgyDay {
  id                   String   @id @default(cuid())
  organizationId       String
  date                 DateTime @db.Date
  liturgicalYear       String?
  season               String?
  weekNumber           Int?
  rank                 String?
  feastName            String?
  liturgicalColour     String?
  saintOfDay           String?
  saintBio             String?  @db.Text
  saintPatronage       String?
  firstReading         String?  @db.Text
  psalm                String?  @db.Text
  secondReading        String?  @db.Text
  gospelReference      String?
  gospelTitle          String?
  gospelText           String?  @db.Text
  bibleVerse           String?  @db.Text
  bibleVerseReference  String?
  bibleVerseTheme      String?
  prayerTitle          String?
  prayerText           String?  @db.Text
  reflectionText       String?  @db.Text
  massNotes            String?  @db.Text
  language             String   @default("en")
  source               String?
  importBatchId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch  LiturgyImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reflectionVariants DailyLiturgyReflectionVariant[]

  @@unique([organizationId, date, language])
  @@index([organizationId, date])
  @@index([importBatchId])
}

model LiturgyImportBatch {
  id             String   @id @default(cuid())
  organizationId String
  filename       String?
  rowCount       Int      @default(0)
  successCount   Int      @default(0)
  errorCount     Int      @default(0)
  errorsJson     Json?
  uploadedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  days         DailyLiturgyDay[]

  @@index([organizationId, createdAt])
}

/// Phase 2: parish/diocese overlays for reflection & messages only (gospel stays master-locked).
model DailyContentOverride {
  id               String   @id @default(cuid())
  organizationId   String
  /// "diocese" or "parish:<parishId>"
  scopeKey         String
  parishId         String?
  date             DateTime @db.Date
  /// Parish or diocese reflection (overrides master reflectionText when set)
  reflectionText   String?  @db.Text
  /// Bishop / diocese pastoral message for the day
  bishopMessage    String?  @db.Text
  bishopTitle      String?
  /// Parish announcement / notice for the day
  announcementText String?  @db.Text
  announcementTitle String?
  language         String   @default("en")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parish       Parish?      @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, date, scopeKey])
  @@index([organizationId, date])
  @@index([parishId, date])
}

/// Phase 3: audience-specific reflection variants generated from gospel (children/youth/family/homily).
enum LiturgyReflectionAudience {
  CHILDREN
  YOUTH
  FAMILY
  HOMILY
}

model DailyLiturgyReflectionVariant {
  id               String                    @id @default(cuid())
  organizationId   String
  dailyLiturgyDayId String?
  date             DateTime                  @db.Date
  audience         LiturgyReflectionAudience
  title            String?
  body             String                    @db.Text
  /// Homily talking points (array of strings)
  bulletPoints     Json?
  status           String                    @default("PUBLISHED")
  source           String                    @default("generated")
  language         String                    @default("en")
  createdById      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dailyLiturgyDay DailyLiturgyDay? @relation(fields: [dailyLiturgyDayId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, date, audience, language])
  @@index([organizationId, date])
  @@index([dailyLiturgyDayId])
}

