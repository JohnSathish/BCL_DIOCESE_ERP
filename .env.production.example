# Copy to .env.production on the production host (never commit real secrets)
# Shared Hostinger VPS: prefer .env.hostinger.example + docs/HOSTINGER_VPS.md

NODE_ENV=production

DATABASE_URL=postgresql://bcl:CHANGE_ME_STRONG@postgres:5432/bcl_enterprise?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=CHANGE_ME_PROD_ACCESS_MIN_32_CHARS!!!!!!!
JWT_REFRESH_SECRET=CHANGE_ME_PROD_REFRESH_MIN_32_CHARS!!!!!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

API_PORT=4000
API_URL=https://api.turadiocese.in
WEB_URL=https://erp.turadiocese.in
NEXT_PUBLIC_API_URL=https://api.turadiocese.in/api/v1
NEXT_PUBLIC_DIOCESE_PRIMARY_DOMAIN=turadiocese.in
DIOCESE_PUBLIC_BASE_DOMAIN=turadiocese.in
CMS_RESOLVE_API_URL=http://api:4000/api/v1
CORS_ORIGINS=https://turadiocese.in,https://www.turadiocese.in,https://erp.turadiocese.in,https://api.turadiocese.in,https://sacredheart.turadiocese.in,https://sacredheartshrinetura.in,https://www.sacredheartshrinetura.in,https://erp.sacredheartshrinetura.in,https://api.sacredheartshrinetura.in

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads

SEED_ON_START=false
SEED_MODE=production
PRISMA_SCHEMA_PUSH=true
