{
  "name": "bcl-enterprise-suite",
  "private": true,
  "version": "0.1.0",
  "description": "BCL Enterprise Suite — shared platform + Diocese ERP",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:apps": "pnpm --parallel --filter @bcl/api --filter @bcl/web run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bcl/api exec prisma generate",
    "db:migrate": "pnpm --filter @bcl/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @bcl/api exec prisma db seed",
    "db:push": "pnpm --filter @bcl/api exec prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "sharp"
    ]
  }
}
