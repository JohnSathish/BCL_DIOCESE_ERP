# Copy to project root as `.env.production` on the Hostinger VPS.
# NEVER commit the real file with secrets.

COMPOSE_PROJECT_NAME=bcl-diocese
NODE_ENV=production

# ——— Isolated DB (Docker internal only — not your college/dosa Postgres) ———
POSTGRES_USER=bcl
POSTGRES_PASSWORD=CHANGE_ME_USE_HEX_ONLY_PASSWORD
POSTGRES_DB=bcl_enterprise
# Keep password alphanumeric/hex only (no @ : / # ?). Compose builds URL; this is fallback.
DATABASE_URL=postgresql://bcl:CHANGE_ME_USE_HEX_ONLY_PASSWORD@postgres:5432/bcl_enterprise
REDIS_URL=redis://redis:6379

# ——— Auth (generate long random strings, 32+ chars) ———
JWT_ACCESS_SECRET=CHANGE_ME_PROD_ACCESS_MIN_32_CHARS!!!!!!!
JWT_REFRESH_SECRET=CHANGE_ME_PROD_REFRESH_MIN_32_CHARS!!!!!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ——— Public URLs (both domains on same stack) ———
API_URL=https://api.turadiocese.in
WEB_URL=https://erp.turadiocese.in
NEXT_PUBLIC_API_URL=https://api.turadiocese.in/api/v1
NEXT_PUBLIC_DIOCESE_PRIMARY_DOMAIN=turadiocese.in
DIOCESE_PUBLIC_BASE_DOMAIN=turadiocese.in
CMS_RESOLVE_API_URL=http://api:4000/api/v1

CORS_ORIGINS=https://turadiocese.in,https://www.turadiocese.in,https://erp.turadiocese.in,https://api.turadiocese.in,https://sacredheart.turadiocese.in,https://sacredheartshrinetura.in,https://www.sacredheartshrinetura.in,https://erp.sacredheartshrinetura.in,https://api.sacredheartshrinetura.in

# Local disk on VPS first (switch to R2/S3 later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads

# First boot only: true → seed Sacred Heart + Diocese of Tura, then set false and recreate api
# IMPORTANT: leave false after first deploy or demo sacraments reappear on every API restart
SEED_ON_START=false
SEED_MODE=production
PRISMA_SCHEMA_PUSH=true

SEED_SUPER_ADMIN_EMAIL=admin@basecodelabs.com
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ——— Hostinger mailbox (OTP + security emails) ———
EMAIL_FROM=BCL Diocese ERP <admin@sacredheartshrinetura.in>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@sacredheartshrinetura.in
SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD

# ——— Trusted device + email OTP ———
TRUSTED_DEVICE_DURATION_DAYS=30
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_PEPPER=CHANGE_ME_OTP_PEPPER_MIN_32_CHARS!!!!!!!!
TRUSTED_DEVICE_SAMESITE=none
TRUSTED_DEVICE_COOKIE_SECURE=true
