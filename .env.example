# Database
DATABASE_URL=postgresql://bcl:bclsecret@localhost:5433/bcl_enterprise?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# App
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Storage (local | s3 | r2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# AWS S3 (STORAGE_DRIVER=s3)
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Cloudflare R2 (STORAGE_DRIVER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Seed
SEED_SUPER_ADMIN_EMAIL=admin@basecodelabs.com
SEED_SUPER_ADMIN_PASSWORD=Admin@12345

# Push (Expo) — create at https://expo.dev → Account → Access Tokens
# Required for App Control + parish Communication Center PUSH delivery
EXPO_ACCESS_TOKEN=

# Email (optional — Resend or SMTP)
# RESEND_API_KEY=
# EMAIL_FROM=Diocese ERP <noreply@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# SMS / WhatsApp (optional — Twilio)
# FEATURE_SMS=true
# FEATURE_WHATSAPP=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1...
# TWILIO_WHATSAPP_FROM=whatsapp:+1...

# LLM (optional — OpenAI-compatible chat completions)
# FEATURE_LLM=true
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MAX_TOKENS=2048

# Liturgy — USCCB daily readings sync (disabled only when false)
# FEATURE_USCCB_SYNC=true

# Environments: see .env.development.example / .env.staging.example / .env.production.example
# Production deploy: docs/PRODUCTION.md
# SEED_ON_START=false
# CMS_RESOLVE_API_URL=http://localhost:4000/api/v1
# CORS_ORIGINS=https://sacredheartshrinetura.in,https://erp.sacredheartshrinetura.in
