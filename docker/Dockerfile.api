FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --filter @bcl/api...

FROM deps AS build
WORKDIR /app
RUN pnpm --filter @bcl/types build
RUN pnpm --filter @bcl/i18n build || true
RUN pnpm --filter @bcl/api exec prisma generate
RUN pnpm --filter @bcl/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Never auto-seed production. Set SEED_ON_START=true only for first bootstrap.
ENV SEED_ON_START=false
# Until Prisma migrations catch up with schema, Hostinger first deploys use db push.
ENV PRISMA_SCHEMA_PUSH=true
RUN corepack enable
COPY --from=build /app /app
COPY docker/entrypoint-api.sh /app/docker/entrypoint-api.sh
RUN chmod +x /app/docker/entrypoint-api.sh
WORKDIR /app/apps/api
EXPOSE 4000
ENTRYPOINT ["/app/docker/entrypoint-api.sh"]
