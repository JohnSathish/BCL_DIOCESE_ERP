# Copy to .env.staging on the staging host (never commit real secrets)
NODE_ENV=staging

DATABASE_URL=postgresql://bcl:CHANGE_ME@staging-db:5432/bcl_enterprise?schema=public
REDIS_URL=redis://staging-redis:6379

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_MIN_32_CHARS!!
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_MIN_32_CHARS!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

API_PORT=4000
API_URL=https://api.staging.example.com
WEB_URL=https://erp.staging.example.com
NEXT_PUBLIC_API_URL=https://api.staging.example.com/api/v1
NEXT_PUBLIC_DIOCESE_PRIMARY_DOMAIN=turadiocese.in
DIOCESE_PUBLIC_BASE_DOMAIN=turadiocese.in
CMS_RESOLVE_API_URL=http://api:4000/api/v1
CORS_ORIGINS=https://staging.example.com,https://erp.staging.example.com

STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

SEED_ON_START=false
